{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.fadianro.am/schema/client.schema.json",
  "title": "RoamID relying party entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["client_id", "protocol", "name", "homepage", "contact", "redirect_uris", "token_endpoint_auth_method", "status"],
  "properties": {
    "$schema": { "type": "string" },
    "client_id": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$", "description": "Permanent identifier. Also the file name. Never changes." },
    "protocol": { "type": "string", "enum": ["oidc"] },
    "name": {
      "type": "object", "additionalProperties": false, "required": ["en"],
      "properties": { "en": { "type": "string", "minLength": 1, "maxLength": 80 }, "zh": { "type": "string", "minLength": 1, "maxLength": 80 } }
    },
    "homepage": { "type": "string", "format": "uri", "maxLength": 300 },
    "domain": { "type": "string", "pattern": "^[a-z0-9.-]{4,253}$", "description": "The application's domain, proven by DNS TXT _roamid-app.<domain> = roamid-app=<client_id> or https://<domain>/.well-known/roamid-app.txt. Shown in the picker. Required for automatic merging." },
    "contact": {
      "type": "object", "additionalProperties": false, "required": ["github", "email"],
      "properties": {
        "github": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 }
      }
    },
    "redirect_uris": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "format": "uri", "maxLength": 500 } },
    "post_logout_redirect_uris": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "format": "uri", "maxLength": 500 } },
    "token_endpoint_auth_method": { "type": "string", "enum": ["none", "private_key_jwt", "client_secret_basic", "client_secret_post"] },
    "jwks_uri": { "type": "string", "format": "uri", "maxLength": 500 },
    "client_secret_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "allowed_idps": { "description": "Offer only these identity providers. Providers added to the registry later are not offered until listed here. Not together with excluded_idps.", "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" } },
    "excluded_idps": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" }, "description": "Offer every active identity provider except these. Providers added to the registry later are offered automatically. Not together with allowed_idps." },
    "subject_type": { "type": "string", "enum": ["public", "pairwise"] },
    "id_token_signed_response_alg": { "type": "string", "enum": ["RS256", "ES256"], "description": "Algorithm of the ID tokens issued to this client. Default RS256." },
    "note": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Optional plain-text note shown with the entry on /idps and /apps, for example why it is disabled." },
    "status": { "type": "string", "enum": ["active", "disabled"] }
  }
}
