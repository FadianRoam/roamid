{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://id.fadianro.am/schema/client-saml2.schema.json",
  "title": "RoamID relying party entry (SAML 2.0 service provider)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "protocol",
    "name",
    "homepage",
    "contact",
    "entity_id",
    "acs_urls",
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{2,64}$",
      "description": "Permanent identifier. Also the file name. Never changes."
    },
    "protocol": {
      "type": "string",
      "enum": [
        "saml2"
      ]
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9.-]{4,253}$",
      "description": "The application's domain, proven by DNS TXT _roamid-app.<domain> = roamid-app=<client_id> or https://<domain>/.well-known/roamid-app.txt. Shown in the picker. Required for automatic merging."
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "maxLength": 300
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github",
        "email"
      ],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        }
      }
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "The service provider's entityID (the Issuer of its AuthnRequests and the Audience of RoamID's assertions)."
    },
    "acs_urls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 500
      },
      "description": "AssertionConsumerService URLs (HTTP-POST), compared exactly."
    },
    "idp_initiated": {
      "type": "boolean",
      "description": "Allow IdP-initiated sign-in (/saml/idp/sso?sp=<client_id>). Default false: only SP-initiated requests."
    },
    "sign_cert": {
      "type": "string",
      "minLength": 100,
      "maxLength": 8000,
      "description": "When present, AuthnRequests must be signed with this certificate's key."
    },
    "allowed_idps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{2,32}$"
      },
      "description": "Offer only these identity providers. Providers added to the registry later are not offered until listed here. Not together with excluded_idps."
    },
    "excluded_idps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{2,32}$"
      },
      "description": "Offer every active identity provider except these. Providers added to the registry later are offered automatically. Not together with allowed_idps."
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "public",
        "pairwise"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Optional plain-text note shown with the entry on /idps and /apps, for example why it is disabled."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    }
  }
}
